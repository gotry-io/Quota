{
  "name": "@gotry-io/quota-relay",
  "version": "0.0.3",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:cloudflare",
    "build:web": "pnpm --filter @gotry-io/quota-web build",
    "build:cloudflare": "pnpm run build:web && pnpm run test:integration && wrangler deploy --dry-run --outdir dist/cloudflare",
    "check": "tsc -p tsconfig.json",
    "deploy:cloudflare": "pnpm run build:web && wrangler deploy",
    "dev": "pnpm run build:web && wrangler dev",
    "d1:migrate:local": "wrangler d1 migrations apply quota --local",
    "d1:migrate:remote": "wrangler d1 migrations apply quota --remote",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@gotry-io/quota-model": "workspace:*",
    "@gotry-io/quota-protocol": "workspace:*",
    "@gotry-io/relay-core": "workspace:*",
    "hono": "4.12.33"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.3"
  }
}
