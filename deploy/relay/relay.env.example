GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_SERVICES_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
# Each of these three must be at least 32 characters. Generate replacements with
# `openssl rand -hex 24`. Shorter values refuse to start.
IDENTITY_SUBJECT_KEY=5e4e46d7a3040f6a506cf930ff6b3b0429d784482080b67d
QUOTA_INSTALLATION_KEY=38e73f819eea71321ad6a2d73d77cdeb0af7414659f59b47
QUOTA_SESSION_HASH_KEY=d25290d0a757c0d844e478486a706bc75f42c3b465e8a79b
RESEND_API_KEY=
RELAY_SQLITE_PATH=
RELAY_STATIC_DIR=
PORT=
# Comma-separated CIDRs/addresses of reverse proxies whose chosen client-address
# header Relay will honour. Unset or empty uses loopback, RFC1918, and
# unique-local IPv6 (Caddy or cloudflared on the same Docker network). Invalid
# values refuse to start. Do not list the public internet.
RELAY_TRUSTED_PROXIES=
# Which header a trusted proxy uses to name the client.
# x-forwarded-for (the default if unset): Caddy overwrites X-Forwarded-For;
# inbound CF-Connecting-IP is ignored.
# cf-connecting-ip: Cloudflare-in-front or cloudflared Tunnel. Production on
# dmit must set this. Direct-to-origin requests can forge it, so the origin
# must only accept Cloudflare's ranges.
RELAY_CLIENT_ADDRESS_HEADER=cf-connecting-ip
TUNNEL_TOKEN=
TZ=
