{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quota.gotry.io/schema/local-usage.json",
  "title": "Quota local Usage report",
  "$comment": "Local-only Usage collection status and coverage; period summaries are precomputed in the private state snapshot.",
  "type": "object",
  "properties": {
    "generated_at": {
      "$ref": "#/$defs/__schema0"
    },
    "aggregation_timezone": {
      "$ref": "#/$defs/__schema1"
    },
    "range": {
      "$ref": "#/$defs/__schema2"
    },
    "status": {
      "$ref": "#/$defs/__schema4"
    },
    "model_catalog_revision": {
      "$ref": "#/$defs/__schema5"
    },
    "coverage": {
      "$ref": "#/$defs/__schema6"
    }
  },
  "required": [
    "generated_at",
    "aggregation_timezone",
    "range",
    "status",
    "model_catalog_revision",
    "coverage"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._+-]+(?:\\/[A-Za-z0-9._+-]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/__schema3"
        },
        "to": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": ["from", "to"],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "__schema4": {
      "type": "string",
      "enum": ["complete", "partial", "unavailable"]
    },
    "__schema5": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema6": {
      "maxItems": 2048,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      }
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "agent": {
          "$ref": "#/$defs/__schema8"
        },
        "start_at": {
          "$ref": "#/$defs/__schema9"
        },
        "end_at": {
          "$ref": "#/$defs/__schema9"
        },
        "status": {
          "$ref": "#/$defs/__schema10"
        }
      },
      "required": ["agent", "start_at", "end_at", "status"],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "string",
      "enum": ["codex", "claude_code", "grok", "opencode", "pi", "cursor"]
    },
    "__schema9": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$"
    },
    "__schema10": {
      "type": "string",
      "enum": ["complete", "partial"]
    }
  }
}
