{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quota.gotry.io/schema/usage.json",
  "title": "Quota Usage payloads",
  "$comment": "Runtime validation additionally enforces token subset conservation, source-cost coverage, unique row identities within an hour, and one entry per hour within an upload.",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/__schema0"
        },
        "generation": {
          "$ref": "#/$defs/__schema1"
        },
        "agent": {
          "$ref": "#/$defs/__schema3"
        },
        "hours": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": ["protocol_version", "generation", "agent", "hours"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "number",
          "const": 6
        },
        "device_id": {
          "$ref": "#/$defs/__schema16"
        },
        "device_generation": {
          "$ref": "#/$defs/__schema1"
        },
        "accepted": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        },
        "ignored": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        }
      },
      "required": ["protocol_version", "device_id", "device_generation", "accepted", "ignored"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "totals": {
          "$ref": "#/$defs/__schema17"
        },
        "cost": {
          "$ref": "#/$defs/__schema18"
        },
        "partial": {
          "type": "boolean"
        },
        "agents": {
          "maxItems": 6,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema29"
          }
        }
      },
      "required": ["totals", "cost", "partial", "agents"],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "number",
      "const": 6
    },
    "__schema1": {
      "minimum": 1,
      "$ref": "#/$defs/__schema2"
    },
    "__schema2": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema3": {
      "type": "string",
      "enum": ["codex", "claude_code", "grok", "opencode", "pi", "cursor"]
    },
    "__schema4": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema5"
      }
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "bucket_start_utc": {
          "$ref": "#/$defs/__schema6"
        },
        "scan_version": {
          "$ref": "#/$defs/__schema2"
        },
        "partial": {
          "$ref": "#/$defs/__schema7"
        },
        "rows": {
          "$ref": "#/$defs/__schema8"
        }
      },
      "required": ["bucket_start_utc", "scan_version", "partial", "rows"],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$"
    },
    "__schema7": {
      "type": "boolean"
    },
    "__schema8": {
      "maxItems": 512,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema9"
      }
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "agent": {
          "$ref": "#/$defs/__schema3"
        },
        "billing_channel": {
          "$ref": "#/$defs/__schema10"
        },
        "channel_source": {
          "$ref": "#/$defs/__schema11"
        },
        "model": {
          "$ref": "#/$defs/__schema12"
        },
        "context_bucket": {
          "$ref": "#/$defs/__schema13"
        },
        "service_tier": {
          "$ref": "#/$defs/__schema14"
        },
        "speed": {
          "$ref": "#/$defs/__schema14"
        },
        "inference_geo": {
          "$ref": "#/$defs/__schema14"
        },
        "input_tokens": {
          "$ref": "#/$defs/__schema2"
        },
        "cache_read_tokens": {
          "$ref": "#/$defs/__schema2"
        },
        "cache_write_5m_tokens": {
          "$ref": "#/$defs/__schema2"
        },
        "cache_write_1h_tokens": {
          "$ref": "#/$defs/__schema2"
        },
        "cache_write_inferred_tokens": {
          "$ref": "#/$defs/__schema2"
        },
        "output_tokens": {
          "$ref": "#/$defs/__schema2"
        },
        "reasoning_tokens": {
          "$ref": "#/$defs/__schema2"
        },
        "requests": {
          "$ref": "#/$defs/__schema1"
        },
        "web_search_requests": {
          "$ref": "#/$defs/__schema2"
        },
        "web_fetch_requests": {
          "$ref": "#/$defs/__schema2"
        },
        "source_cost_microusd": {
          "$ref": "#/$defs/__schema15"
        },
        "source_cost_covered_requests": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "agent",
        "billing_channel",
        "channel_source",
        "model",
        "context_bucket",
        "service_tier",
        "speed",
        "inference_geo",
        "input_tokens",
        "cache_read_tokens",
        "cache_write_5m_tokens",
        "cache_write_1h_tokens",
        "cache_write_inferred_tokens",
        "output_tokens",
        "reasoning_tokens",
        "requests",
        "web_search_requests",
        "web_fetch_requests",
        "source_cost_covered_requests"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "string",
      "enum": [
        "openai_direct",
        "azure_openai",
        "anthropic_direct",
        "aws_bedrock",
        "google_vertex",
        "openrouter",
        "xai_direct",
        "moonshot_direct",
        "deepseek_direct",
        "unknown"
      ]
    },
    "__schema11": {
      "type": "string",
      "enum": ["explicit", "agent_default", "unknown"]
    },
    "__schema12": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=[\\s\\S]{1,128}$)(?![\\s\\S]*\\p{Cc})[\\s\\S]+$"
    },
    "__schema13": {
      "type": "string",
      "enum": ["le_128k", "gt_128k_le_200k", "gt_200k_le_256k", "gt_256k_le_272k", "gt_272k"]
    },
    "__schema14": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
    },
    "__schema15": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(?:0|[1-9]\\d*)$"
    },
    "__schema16": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema17": {
      "type": "object",
      "properties": {
        "total_tokens": {
          "$ref": "#/$defs/__schema2"
        },
        "input_tokens": {
          "$ref": "#/$defs/__schema2"
        },
        "output_tokens": {
          "$ref": "#/$defs/__schema2"
        },
        "cache_read_input_tokens": {
          "$ref": "#/$defs/__schema2"
        },
        "cache_write_input_tokens": {
          "$ref": "#/$defs/__schema2"
        },
        "reasoning_tokens": {
          "$ref": "#/$defs/__schema2"
        },
        "messages": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "total_tokens",
        "input_tokens",
        "output_tokens",
        "cache_read_input_tokens",
        "cache_write_input_tokens",
        "reasoning_tokens",
        "messages"
      ],
      "additionalProperties": false
    },
    "__schema18": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/__schema19"
        },
        "basis": {
          "$ref": "#/$defs/__schema20"
        },
        "status": {
          "$ref": "#/$defs/__schema21"
        },
        "amount_microusd": {
          "$ref": "#/$defs/__schema22"
        },
        "catalog_revision": {
          "$ref": "#/$defs/__schema23"
        },
        "calculated_rows": {
          "$ref": "#/$defs/__schema2"
        },
        "reported_rows": {
          "$ref": "#/$defs/__schema2"
        },
        "unpriced_rows": {
          "$ref": "#/$defs/__schema2"
        },
        "assumptions": {
          "$ref": "#/$defs/__schema24"
        },
        "unpriced": {
          "$ref": "#/$defs/__schema26"
        },
        "unpriced_truncated": {
          "$ref": "#/$defs/__schema28"
        }
      },
      "required": [
        "mode",
        "basis",
        "status",
        "amount_microusd",
        "catalog_revision",
        "calculated_rows",
        "reported_rows",
        "unpriced_rows",
        "assumptions",
        "unpriced"
      ],
      "additionalProperties": false
    },
    "__schema19": {
      "type": "string",
      "enum": ["calculate", "auto", "reported"]
    },
    "__schema20": {
      "type": "string",
      "enum": ["calculated", "reported", "mixed", "none"]
    },
    "__schema21": {
      "type": "string",
      "enum": ["complete", "partial", "unavailable"]
    },
    "__schema22": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 32,
          "pattern": "^(?:0|[1-9]\\d*)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema23": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema16"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema24": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema25"
      }
    },
    "__schema25": {
      "type": "string",
      "enum": [
        "agent_default_channel",
        "model_alias",
        "wildcard_service_tier",
        "wildcard_speed",
        "wildcard_inference_geo",
        "wildcard_context_bucket",
        "cache_write_inferred_rate",
        "source_reported",
        "vendor_official_price"
      ]
    },
    "__schema26": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema27"
      }
    },
    "__schema27": {
      "type": "object",
      "properties": {
        "billing_channel": {
          "$ref": "#/$defs/__schema10"
        },
        "model": {
          "$ref": "#/$defs/__schema12"
        },
        "reason": {
          "type": "string",
          "enum": [
            "unknown_channel",
            "unknown_model",
            "outside_effective_range",
            "unsupported_dimensions",
            "ambiguous_price",
            "missing_rate",
            "incomplete_source_cost",
            "invalid_catalog"
          ]
        },
        "rows": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": ["billing_channel", "model", "reason", "rows"],
      "additionalProperties": false
    },
    "__schema28": {
      "type": "boolean",
      "const": true
    },
    "__schema29": {
      "type": "object",
      "properties": {
        "agent": {
          "$ref": "#/$defs/__schema3"
        },
        "providers": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema30"
          }
        }
      },
      "required": ["agent", "providers"],
      "additionalProperties": false
    },
    "__schema30": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "google",
            "xai",
            "moonshot",
            "deepseek",
            "cursor",
            "unknown"
          ]
        },
        "models": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema31"
          }
        }
      },
      "required": ["provider", "models"],
      "additionalProperties": false
    },
    "__schema31": {
      "type": "object",
      "properties": {
        "model": {
          "$ref": "#/$defs/__schema12"
        },
        "totals": {
          "$ref": "#/$defs/__schema17"
        },
        "cost": {
          "$ref": "#/$defs/__schema18"
        }
      },
      "required": ["model", "totals", "cost"],
      "additionalProperties": false
    }
  }
}
