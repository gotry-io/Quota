    },
    "__schema15": {
      "maxItems": 8192,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "__schema16": {
      "type": "object",
      "properties": {
        "range": {
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/$defs/__schema17"
