        "model_alias",
        "wildcard_service_tier",
        "wildcard_speed",
        "wildcard_inference_geo",
        "wildcard_context_bucket",
        "cache_write_inferred_rate",
        "source_reported"
      ]
    },
    "__schema28": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema29"
      }
    },
    "__schema29": {
      "type": "object",
      "properties": {
