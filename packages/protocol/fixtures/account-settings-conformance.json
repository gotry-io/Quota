  "reapply": [
    {
      "name": "a threshold edit is replayed onto a document that gained another selector",
      "edit": {
        "kind": "set_thresholds",
        "selector": "a1b2c3d4e5f6",
        "thresholds": [30, 5]
      },
      "fresh": {
        "alerts": {
          "reset_reminders": true,
          "pace_alerts": true,
          "thresholds": {
            "112233445566": [20, 10]
          }
        },
        "budget": {
          "amount_usd": "100.00",
          "alerts": true
        }
      },
      "expected": {
        "alerts": {
          "reset_reminders": true,
          "pace_alerts": true,
          "thresholds": {
            "112233445566": [20, 10],
            "a1b2c3d4e5f6": [30, 5]
          }
        },
        "budget": {
          "amount_usd": "100.00",
          "alerts": true
        }
      }
    },
    {
      "name": "a reset-reminder edit keeps selectors the editor does not recognise",
      "edit": {
