{
  "name": "@gotry/quota-relay",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:cloudflare && pnpm run build:self-hosted",
    "build:cloudflare": "wrangler deploy --dry-run --outdir dist/cloudflare",
    "build:self-hosted": "bun build --target=bun --minify --outfile dist/self-hosted/quotarelay.js src/self-hosted.ts",
    "check": "tsc -p tsconfig.json",
    "dev": "wrangler dev",
    "dev:self-hosted": "bun run src/self-hosted.ts",
    "d1:migrate:local": "wrangler d1 migrations apply quota-relay --local",
    "d1:migrate:remote": "wrangler d1 migrations apply quota-relay --remote",
    "test": "vitest run test/app.test.ts && bun test test/sqlite-state.bun.test.ts"
  },
  "dependencies": {
    "@gotry/quota-protocol": "workspace:*",
    "@gotry/relay-core": "workspace:*",
    "hono": "4.12.33"
  }
}
