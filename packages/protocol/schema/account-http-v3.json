        },
        "cache_write_5m_tokens": {
          "$ref": "#/$defs/__schema2"
        },
        "cache_write_1h_tokens": {
          "$ref": "#/$defs/__schema2"
        },
        "cache_write_inferred_tokens": {
          "$ref": "#/$defs/__schema2"
        },
        "output_tokens": {
          "$ref": "#/$defs/__schema2"
        },
        "reasoning_tokens": {
          "$ref": "#/$defs/__schema2"
        },
        "requests": {
          "$ref": "#/$defs/__schema2"
        },
        "web_search_requests": {
          "$ref": "#/$defs/__schema2"
        },
        "web_fetch_requests": {
          "$ref": "#/$defs/__schema2"
        },
        "source_cost_microusd": {
          "$ref": "#/$defs/__schema19"
        },
        "source_cost_covered_requests": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "input_tokens",
        "cache_read_tokens",
        "cache_write_5m_tokens",
        "cache_write_1h_tokens",
        "cache_write_inferred_tokens",
        "output_tokens",
        "reasoning_tokens",
        "requests",
        "web_search_requests",
        "web_fetch_requests",
        "source_cost_microusd",
        "source_cost_covered_requests"
      ],
      "additionalProperties": false
    },
    "__schema19": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 32,
          "pattern": "^(?:0|[1-9]\\d*)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema20": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/__schema21"
        },
        "basis": {
          "$ref": "#/$defs/__schema22"
        },
        "status": {
          "$ref": "#/$defs/__schema23"
        },
        "amount_microusd": {
          "$ref": "#/$defs/__schema24"
        },
        "catalog_revision": {
          "$ref": "#/$defs/__schema25"
        },
        "calculated_rows": {
          "$ref": "#/$defs/__schema2"
        },
        "reported_rows": {
          "$ref": "#/$defs/__schema2"
        },
        "unpriced_rows": {
          "$ref": "#/$defs/__schema2"
        },
        "assumptions": {
          "$ref": "#/$defs/__schema26"
        },
        "unpriced": {
          "$ref": "#/$defs/__schema28"
        },
        "unpriced_truncated": {
          "$ref": "#/$defs/__schema32"
        }
