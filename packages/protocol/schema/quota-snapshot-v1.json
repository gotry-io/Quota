{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quota.gotry.io/schema/quota-snapshot-v1.json",
  "title": "Quota snapshot envelope",
  "type": "object",
  "required": ["schema_version", "device_id", "sequence", "captured_at", "snapshots"],
  "properties": {
    "schema_version": { "const": 1 },
    "device_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "captured_at": { "type": "string", "format": "date-time" },
    "snapshots": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/snapshot" }
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "required": ["provider", "account", "windows", "source", "status", "observed_at"],
      "properties": {
        "provider": { "enum": ["codex", "claude", "grok", "openrouter"] },
        "account": {
          "type": "object",
          "required": ["fingerprint", "fingerprint_scope"],
          "properties": {
            "fingerprint": { "type": "string", "minLength": 1 },
            "fingerprint_scope": { "enum": ["global", "source"] },
            "label": { "type": "string", "minLength": 1 },
            "plan": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "used_percent"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "used_percent": { "type": "number", "minimum": 0, "maximum": 100 },
              "resets_at": { "type": "string", "format": "date-time" },
              "duration_seconds": { "type": "integer", "minimum": 0 },
              "remaining_value": { "type": "number" },
              "limit_value": { "type": "number", "minimum": 0 },
              "value_unit": { "enum": ["usd", "credits", "count"] }
            },
            "additionalProperties": false
          }
        },
        "source": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["available", "stale", "auth_required", "unavailable", "unsupported", "error"]
        },
        "observed_at": { "type": "string", "format": "date-time" },
        "valid_until": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
