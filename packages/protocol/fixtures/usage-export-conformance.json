{
  "$comment": "How a Usage period export is written. The website and QuotaBar both answer this file. CSV is one row per local date in the asked [from, to]; a date absent from days[] is an empty row marked no usage recorded in cost status, and is omitted from JSON days (missing ≠ zero). Unpriced cost is empty / null with status unpriced, never 0. Text cells that start with =, +, -, @, tab, or CR are prefixed with a single quote; numbers stay plain; RFC 4180 quoting. See ADR 0056.",
  "csv_header": "date,total tokens,input,output,cache read,cache write,reasoning,messages,API-equivalent cost,cost status",
  "csv_cell_cases": [
    { "name": "formula_equals", "input": "=1+1", "kind": "text", "expected": "'=1+1" },
    { "name": "formula_plus", "input": "+SUM(A1)", "kind": "text", "expected": "'+SUM(A1)" },
    { "name": "formula_minus", "input": "-1", "kind": "text", "expected": "'-1" },
    { "name": "formula_at", "input": "@cmd", "kind": "text", "expected": "'@cmd" },
    { "name": "formula_tab", "input": "\tTAB", "kind": "text", "expected": "'\tTAB" },
    { "name": "formula_cr", "input": "\rCR", "kind": "text", "expected": "\"'\rCR\"" },
    { "name": "comma", "input": "hello, world", "kind": "text", "expected": "\"hello, world\"" },
    { "name": "quotes", "input": "say \"hi\"", "kind": "text", "expected": "\"say \"\"hi\"\"\"" },
    { "name": "plain", "input": "plain", "kind": "text", "expected": "plain" },
    { "name": "empty", "input": "", "kind": "text", "expected": "" },
    { "name": "number", "input": "12", "kind": "number", "expected": "12" },
    { "name": "decimal", "input": "1.49", "kind": "number", "expected": "1.49" },
    { "name": "negative_number", "input": "-3", "kind": "number", "expected": "-3" }
  ],
  "cases": [
    {
      "name": "missing_and_unpriced",
      "input": {
        "scope": "Account",
        "from": "2026-08-26",
        "to": "2026-08-28",
