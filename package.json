{
  "name": "@gotry-io/quota",
  "version": "0.0.1",
  "license": "MIT",
  "homepage": "https://quota.gotry.io",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @gotry-io/quotacli build && pnpm --filter @gotry-io/quota-relay build && swift build --package-path apps/menubar",
    "check": "pnpm -r --if-present check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "pnpm -r --if-present test && swift test --package-path apps/menubar",
    "build:menubar:app": "./scripts/package-menubar.sh",
    "build:menubar:visual": "./scripts/package-menubar-visual.sh",
    "test:menubar:visual": "./scripts/accept-menubar-visual.sh",
    "test:relay:e2e": "./scripts/test-relay-owner-e2e.sh",
    "deploy:cloudflare": "pnpm --filter @gotry-io/quota-relay deploy:cloudflare",
    "dev:web": "pnpm --filter @gotry-io/quota-web dev",
    "dev:relay": "pnpm --filter @gotry-io/quota-relay dev",
    "dev:relay:self-hosted": "pnpm --filter @gotry-io/quota-relay dev:self-hosted",
    "dev:cli": "pnpm --filter @gotry-io/quotacli dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@cloudflare/workers-types": "5.20260801.1",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  }
}
