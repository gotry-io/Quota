            "to": {
              "$ref": "#/$defs/__schema17"
            }
          },
          "required": ["from", "to"],
          "additionalProperties": false
        },
        "totals": {
          "$ref": "#/$defs/__schema18"
        },
        "cost": {
          "$ref": "#/$defs/__schema20"
        },
        "model_catalog_revision": {
          "$ref": "#/$defs/__schema1"
        },
        "coverage": {
          "maxItems": 2048,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema33"
          }
        },
        "breakdowns": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema37"
          }
        },
        "clients": {
          "maxItems": 6,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema38"
          }
        },
        "coverage_truncated": {
          "type": "boolean",
          "const": true
        },
        "breakdowns_truncated": {
          "type": "boolean",
          "const": true
        }
      },
      "required": ["range", "totals", "cost", "coverage", "breakdowns"],
      "additionalProperties": false
    },
    "__schema17": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "__schema18": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "$ref": "#/$defs/__schema2"
        },
        "cache_read_tokens": {
