{
  "name": "@gotry-io/quota",
  "version": "0.0.3",
  "license": "MIT",
  "homepage": "https://quota.gotry.io",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @gotry-io/quota-relay build && cargo build --locked --package quota-service --package quota-menubar-helper && swift build --package-path apps/menubar",
    "check": "pnpm check:provider-catalog && pnpm -r --if-present check && cargo check --locked --package quota-service --package quota-menubar-helper --all-targets",
    "check:provider-catalog": "node --experimental-strip-types scripts/generate-provider-catalog.mjs --check",
    "generate:provider-catalog": "node --experimental-strip-types scripts/generate-provider-catalog.mjs",
    "version:bump:cli": "node scripts/bump-version.mjs cli",
    "version:bump:menubar": "node scripts/bump-version.mjs menubar",
    "format": "biome format --write . && cargo fmt --all",
    "format:check": "biome format . && cargo fmt --all -- --check",
    "test": "pnpm -r --if-present test && cargo test --locked --package quota-service --package quota-menubar-helper && swift test --package-path apps/menubar",
    "test:menubar:helper": "./scripts/test-menubar-helper.sh",
    "build:linux-cli": "cargo build --locked --release --package quotacli",
    "check:linux-cli": "cargo check --locked --package quotacli --all-targets",
    "test:linux-cli": "cargo test --locked --package quotacli",
    "build:menubar:app": "./scripts/package-menubar.sh",
    "build:menubar:visual": "./scripts/package-menubar-visual.sh",
    "deploy:cloudflare": "pnpm --filter @gotry-io/quota-relay deploy:cloudflare",
    "dev:web": "pnpm --filter @gotry-io/quota-web dev",
    "dev:relay": "pnpm --filter @gotry-io/quota-relay dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@cloudflare/workers-types": "5.20260801.1",
    "@types/node": "26.1.2",
    "ajv": "8.20.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  }
}
