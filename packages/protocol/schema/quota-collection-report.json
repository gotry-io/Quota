{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quota.gotry.io/schema/quota-collection-report.json",
  "title": "Quota local collection report",
  "$comment": "Success snapshots must use the same provider as their collection result.",
  "type": "object",
  "properties": {
    "captured_at": {
      "$ref": "#/$defs/__schema0"
    },
    "results": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    }
  },
  "required": ["captured_at", "results"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema1": {
      "oneOf": [
        {
          "$ref": "#/$defs/__schema2"
        },
        {
          "$ref": "#/$defs/__schema24"
        }
      ]
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/__schema3"
        },
        "source": {
          "$ref": "#/$defs/__schema4"
        },
        "message": {
          "$ref": "#/$defs/__schema6"
        },
        "sources": {
          "$ref": "#/$defs/__schema7"
        },
        "access_denied": {
          "$ref": "#/$defs/__schema9"
        },
        "outcome": {
          "type": "string",
          "const": "success"
        },
        "snapshots": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema10"
          }
        }
      },
      "required": ["provider", "sources", "outcome", "snapshots"],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "string",
      "enum": [
        "codex",
        "claude",
        "grok",
        "openrouter",
        "deepseek",
        "kimi",
        "litellm",
        "cursor",
        "gemini",
        "copilot",
        "antigravity",
        "opencode_go"
      ]
    },
    "__schema4": {
      "$ref": "#/$defs/__schema5"
    },
    "__schema5": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
    },
    "__schema6": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "__schema7": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema8"
      }
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "source_id": {
          "$ref": "#/$defs/__schema5"
        },
        "outcome": {
          "type": "string",
          "enum": ["success", "auth_required", "unavailable", "unsupported", "error"]
        },
        "category": {
          "type": "string",
          "enum": [
            "success",
            "auth_required",
            "access_denied",
            "unavailable",
            "unsupported",
            "error"
          ]
        }
      },
      "required": ["source_id", "outcome", "category"],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "boolean",
      "const": true
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/__schema3"
        },
        "account": {
          "type": "object",
          "properties": {
            "fingerprint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "fingerprint_scope": {
              "type": "string",
              "enum": ["global", "source"]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "plan": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": ["fingerprint", "fingerprint_scope"],
          "additionalProperties": false
        },
        "windows": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema11"
          }
        },
        "status": {
          "type": "string",
          "enum": ["available", "stale", "auth_required", "unavailable", "unsupported", "error"]
        },
        "observed_at": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": ["provider", "account", "windows", "status", "observed_at"],
      "additionalProperties": false
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema12"
        },
        "title": {
          "$ref": "#/$defs/__schema13"
        },
        "used_percent": {
          "$ref": "#/$defs/__schema14"
        },
        "resets_at": {
          "$ref": "#/$defs/__schema15"
        },
        "duration_seconds": {
          "$ref": "#/$defs/__schema16"
        },
        "primary_cadence": {
          "$ref": "#/$defs/__schema18"
        },
        "remaining_value": {
          "$ref": "#/$defs/__schema19"
        },
        "limit_value": {
          "$ref": "#/$defs/__schema20"
        },
        "value_unit": {
          "$ref": "#/$defs/__schema21"
        },
        "expiries": {
          "$ref": "#/$defs/__schema22"
        }
      },
      "required": ["id", "title", "used_percent"],
      "additionalProperties": false
    },
    "__schema12": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
    },
    "__schema13": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "__schema14": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "__schema15": {
      "$ref": "#/$defs/__schema0"
    },
    "__schema16": {
      "$ref": "#/$defs/__schema17"
    },
    "__schema17": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema18": {
      "type": "string",
      "enum": ["five_hour", "weekly", "monthly"]
    },
    "__schema19": {
      "type": "number"
    },
    "__schema20": {
      "type": "number",
      "minimum": 0
    },
    "__schema21": {
      "type": "string",
      "enum": ["usd", "credits", "count"]
    },
    "__schema22": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema23"
      }
    },
    "__schema23": {
      "type": "object",
      "properties": {
        "expires_at": {
          "$ref": "#/$defs/__schema0"
        },
        "count": {
          "minimum": 1,
          "$ref": "#/$defs/__schema17"
        }
      },
      "required": ["expires_at", "count"],
      "additionalProperties": false
    },
    "__schema24": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/__schema3"
        },
        "source": {
          "$ref": "#/$defs/__schema4"
        },
        "message": {
          "$ref": "#/$defs/__schema6"
        },
        "sources": {
          "$ref": "#/$defs/__schema7"
        },
        "access_denied": {
          "$ref": "#/$defs/__schema9"
        },
        "outcome": {
          "type": "string",
          "enum": ["auth_required", "unavailable", "unsupported", "error"]
        },
        "snapshots": {
          "maxItems": 0,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema10"
          }
        }
      },
      "required": ["provider", "sources", "outcome", "snapshots"],
      "additionalProperties": false
    }
  }
}
