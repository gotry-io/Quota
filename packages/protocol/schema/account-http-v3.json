          "$ref": "#/$defs/__schema48"
        },
        "summary": {
          "$ref": "#/$defs/__schema49"
        },
        "top_code": {
          "$ref": "#/$defs/__schema50"
        },
        "consecutive_failures": {
          "$ref": "#/$defs/__schema51"
        },
        "usage_upload_enabled": {
          "$ref": "#/$defs/__schema52"
        }
