{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quota.gotry.io/schema/relay-info-v1.json",
  "title": "QuotaRelay discovery document",
  "type": "object",
  "required": ["instance_id", "mode", "version", "api_versions", "auth_methods", "capabilities"],
  "properties": {
    "instance_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["managed", "self_hosted"] },
    "version": { "type": "string", "minLength": 1 },
    "api_versions": {
      "type": "array",
      "items": { "const": 1 },
      "minItems": 1
    },
    "auth_methods": {
      "type": "array",
      "items": { "const": "bearer" }
    },
    "capabilities": {
      "type": "object",
      "required": [
        "realtime",
        "persistent_snapshots",
        "instant_device_revocation",
        "history",
        "multi_tenant"
      ],
      "properties": {
        "realtime": { "type": "boolean" },
        "persistent_snapshots": { "type": "boolean" },
        "instant_device_revocation": { "type": "boolean" },
        "history": { "type": "boolean" },
        "multi_tenant": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
