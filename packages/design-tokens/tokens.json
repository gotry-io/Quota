      "warning": {
        "light": "#b45309",
        "dark": "#f0b429",
        "css": ["--quota-warning", "--meter-warn"]
      },
      "critical": {
        "light": "#9f1d1d",
        "dark": "#f0a8a8",
        "css": ["--quota-critical", "--meter-critical", "--danger"]
      }
    },
    "meter": {
