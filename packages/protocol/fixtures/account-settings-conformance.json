      },
      "expected": {
        "alerts": {
          "reset_reminders": false,
          "pace_alerts": false,
          "thresholds": {
            "112233445566": [15],
            "deadbeef0001": [5]
          }
        },
        "budget": {
          "amount_usd": null,
          "alerts": true
        }
      }
    },
    {
