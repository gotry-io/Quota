{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quota.gotry.io/schema/account-http.json",
  "title": "Quota account HTTP payloads",
  "$comment": "Direct Account to Device managed contract.",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "number",
          "const": 2
        },
        "account": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": ["protocol_version", "account"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "number",
          "const": 6
        },
        "account": {
          "$ref": "#/$defs/__schema0"
        },
        "devices": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema4"
          }
        },
        "subscriptions": {
          "maxItems": 1024,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema7"
          }
        },
        "usage": {
          "type": "object",
          "properties": {
            "today": {
              "$ref": "#/$defs/__schema13"
            },
            "last_7_days": {
              "$ref": "#/$defs/__schema13"
            },
            "last_30_days": {
              "$ref": "#/$defs/__schema13"
            },
            "all": {
              "$ref": "#/$defs/__schema13"
            }
          },
          "required": ["today", "last_7_days", "last_30_days", "all"],
          "additionalProperties": false
        },
        "pricing_revision": {
          "$ref": "#/$defs/__schema1"
        },
        "model_catalog_revision": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "protocol_version",
        "account",
        "devices",
        "subscriptions",
        "usage",
        "pricing_revision",
        "model_catalog_revision"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "number",
          "const": 6
        },
        "days": {
          "maxItems": 400,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema31"
          }
        }
      },
      "required": ["protocol_version", "days"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "number",
          "const": 2
        },
        "grant_type": {
          "type": "string",
          "const": "authorization_code"
        },
        "client_id": {
          "$ref": "#/$defs/__schema32"
        },
        "code": {
          "$ref": "#/$defs/__schema33"
        },
        "code_verifier": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{43,128}$"
        },
        "redirect_uri": {
          "type": "string",
          "maxLength": 2048,
          "format": "uri"
        },
        "installation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "device_display_name": {
          "$ref": "#/$defs/__schema5"
        },
        "platform": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "protocol_version",
        "grant_type",
        "client_id",
        "code",
        "code_verifier",
        "redirect_uri",
        "installation_id",
        "device_display_name",
        "platform"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "number",
          "const": 2
        },
        "grant_type": {
          "type": "string",
          "const": "authorization_code"
        },
        "client_id": {
          "$ref": "#/$defs/__schema34"
        },
        "code": {
          "$ref": "#/$defs/__schema33"
        },
        "code_verifier": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{43,128}$"
        },
        "redirect_uri": {
          "type": "string",
          "const": "io.gotry.quota:/oauth/callback"
        }
      },
      "required": [
        "protocol_version",
        "grant_type",
        "client_id",
        "code",
        "code_verifier",
        "redirect_uri"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "number",
          "const": 2
        },
        "token_type": {
          "type": "string",
          "const": "Bearer"
        },
        "account_id": {
          "$ref": "#/$defs/__schema1"
        },
        "display_label": {
          "$ref": "#/$defs/__schema2"
        },
        "session": {
          "$ref": "#/$defs/__schema35"
        }
      },
      "required": ["protocol_version", "token_type", "account_id", "display_label", "session"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "number",
          "const": 2
        },
        "grant_type": {
          "type": "string",
          "const": "refresh_token"
        },
        "client_id": {
          "$ref": "#/$defs/__schema34"
        },
        "refresh_token": {
          "$ref": "#/$defs/__schema33"
        }
      },
      "required": ["protocol_version", "grant_type", "client_id", "refresh_token"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "number",
          "const": 2
        },
        "token_type": {
          "type": "string",
          "const": "Bearer"
        },
        "account_id": {
          "$ref": "#/$defs/__schema1"
        },
        "session": {
          "$ref": "#/$defs/__schema35"
        }
      },
      "required": ["protocol_version", "token_type", "account_id", "session"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "number",
          "const": 2
        },
        "token_type": {
          "type": "string",
          "const": "Bearer"
        },
        "account_id": {
          "$ref": "#/$defs/__schema1"
        },
        "display_label": {
          "$ref": "#/$defs/__schema2"
        },
        "device_id": {
          "$ref": "#/$defs/__schema1"
        },
        "device_generation": {
          "$ref": "#/$defs/__schema26"
        },
        "usage_deleted_before": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema3"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage_sync_revision": {
          "$ref": "#/$defs/__schema11"
        },
        "session": {
          "$ref": "#/$defs/__schema35"
        }
      },
      "required": [
        "protocol_version",
        "token_type",
        "account_id",
        "display_label",
        "device_id",
        "device_generation",
        "usage_deleted_before",
        "usage_sync_revision",
        "session"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "number",
          "const": 2
        },
        "grant_type": {
          "type": "string",
          "const": "refresh_token"
        },
        "client_id": {
          "$ref": "#/$defs/__schema32"
        },
        "refresh_token": {
          "$ref": "#/$defs/__schema33"
        }
      },
      "required": ["protocol_version", "grant_type", "client_id", "refresh_token"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "number",
          "const": 2
        },
        "token_type": {
          "type": "string",
          "const": "Bearer"
        },
        "account_id": {
          "$ref": "#/$defs/__schema1"
        },
        "device_id": {
          "$ref": "#/$defs/__schema1"
        },
        "device_generation": {
          "$ref": "#/$defs/__schema26"
        },
        "session": {
          "$ref": "#/$defs/__schema35"
        }
      },
      "required": [
        "protocol_version",
        "token_type",
        "account_id",
        "device_id",
        "device_generation",
        "session"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "number",
          "const": 2
        },
        "account_id": {
          "$ref": "#/$defs/__schema1"
        },
        "device_id": {
          "$ref": "#/$defs/__schema1"
        },
        "device_generation": {
          "$ref": "#/$defs/__schema26"
        },
        "usage_deleted_before": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema3"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage_sync_revision": {
          "$ref": "#/$defs/__schema11"
        }
      },
      "required": [
        "protocol_version",
        "account_id",
        "device_id",
        "device_generation",
        "usage_deleted_before",
        "usage_sync_revision"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "number",
          "const": 2
        },
        "display_name": {
          "$ref": "#/$defs/__schema5"
        },
        "platform": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": ["protocol_version", "display_name", "platform"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "number",
          "const": 2
        },
        "status": {
          "type": "string",
          "const": "updated"
        },
        "device_id": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": ["protocol_version", "status", "device_id"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "number",
          "const": 2
        },
        "status": {
          "type": "string",
          "const": "signed_out"
        }
      },
      "required": ["protocol_version", "status"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "number",
          "const": 2
        },
        "status": {
          "type": "string",
          "const": "deleted"
        },
        "device_id": {
          "$ref": "#/$defs/__schema1"
        },
        "device_generation": {
          "$ref": "#/$defs/__schema26"
        },
        "deleted_before": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "protocol_version",
        "status",
        "device_id",
        "device_generation",
        "deleted_before"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "number",
          "const": 6
        },
        "device_id": {
          "$ref": "#/$defs/__schema1"
        },
        "device_generation": {
          "$ref": "#/$defs/__schema26"
        },
        "accepted": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema8"
          }
        },
        "ignored": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema8"
          }
        }
      },
      "required": ["protocol_version", "device_id", "device_generation", "accepted", "ignored"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "invalid_request",
                "unauthorized",
                "forbidden",
                "not_found",
                "authorization_pending",
                "slow_down",
                "access_denied",
                "expired_token",
                "invalid_grant",
                "rate_limited",
                "stale_generation",
                "device_deleted",
                "client_upgrade_required",
                "conflict",
                "internal_error"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": ["code", "message"],
          "additionalProperties": false
        }
      },
      "required": ["error"],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "account_id": {
          "$ref": "#/$defs/__schema1"
        },
        "display_label": {
          "$ref": "#/$defs/__schema2"
        },
        "created_at": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": ["account_id", "display_label", "created_at"],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema2": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema3": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema1"
        },
        "display_name": {
          "$ref": "#/$defs/__schema5"
        },
        "platform": {
          "$ref": "#/$defs/__schema6"
        },
        "last_seen_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema3"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_observed_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema3"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["id", "display_name", "platform", "last_seen_at", "last_observed_at"],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "__schema6": {
      "type": "string",
      "enum": ["macos"]
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "provider": {
          "$ref": "#/$defs/__schema8"
        },
        "snapshot": {
          "$ref": "#/$defs/__schema9"
        },
        "sources": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema12"
          }
        }
      },
      "required": ["key", "provider", "snapshot", "sources"],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "string",
      "enum": ["codex", "claude", "grok", "openrouter", "deepseek", "kimi", "litellm", "cursor"]
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/__schema8"
        },
        "account": {
          "type": "object",
          "properties": {
            "fingerprint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "fingerprint_scope": {
              "type": "string",
              "enum": ["global", "source"]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "plan": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": ["fingerprint", "fingerprint_scope"],
          "additionalProperties": false
        },
        "windows": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema10"
          }
        },
        "status": {
          "type": "string",
          "enum": ["available", "stale", "auth_required", "unavailable", "unsupported", "error"]
        },
        "observed_at": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": ["provider", "account", "windows", "status", "observed_at"],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "used_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "resets_at": {
          "$ref": "#/$defs/__schema3"
        },
        "duration_seconds": {
          "$ref": "#/$defs/__schema11"
        },
        "primary_cadence": {
          "type": "string",
          "enum": ["five_hour", "weekly", "monthly"]
        },
        "remaining_value": {
          "type": "number"
        },
        "limit_value": {
          "type": "number",
          "minimum": 0
        },
        "value_unit": {
          "type": "string",
          "enum": ["usd", "credits", "count"]
        }
      },
      "required": ["id", "title", "used_percent"],
      "additionalProperties": false
    },
    "__schema11": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "#/$defs/__schema1"
        },
        "observed_at": {
          "$ref": "#/$defs/__schema3"
        },
        "snapshot": {
          "$ref": "#/$defs/__schema9"
        }
      },
      "required": ["device_id", "observed_at"],
      "additionalProperties": false
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "totals": {
          "$ref": "#/$defs/__schema14"
        },
        "cost": {
          "$ref": "#/$defs/__schema15"
        },
        "partial": {
          "type": "boolean"
        },
        "agents": {
          "maxItems": 6,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema28"
          }
        }
      },
      "required": ["totals", "cost", "partial", "agents"],
      "additionalProperties": false
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "total_tokens": {
          "$ref": "#/$defs/__schema11"
        },
        "input_tokens": {
          "$ref": "#/$defs/__schema11"
        },
        "output_tokens": {
          "$ref": "#/$defs/__schema11"
        },
        "cache_read_input_tokens": {
          "$ref": "#/$defs/__schema11"
        },
        "cache_write_input_tokens": {
          "$ref": "#/$defs/__schema11"
        },
        "reasoning_tokens": {
          "$ref": "#/$defs/__schema11"
        },
        "messages": {
          "$ref": "#/$defs/__schema11"
        }
      },
      "required": [
        "total_tokens",
        "input_tokens",
        "output_tokens",
        "cache_read_input_tokens",
        "cache_write_input_tokens",
        "reasoning_tokens",
        "messages"
      ],
      "additionalProperties": false
    },
    "__schema15": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/__schema16"
        },
        "basis": {
          "$ref": "#/$defs/__schema17"
        },
        "status": {
          "$ref": "#/$defs/__schema18"
        },
        "amount_microusd": {
          "$ref": "#/$defs/__schema19"
        },
        "catalog_revision": {
          "$ref": "#/$defs/__schema20"
        },
        "calculated_rows": {
          "$ref": "#/$defs/__schema11"
        },
        "reported_rows": {
          "$ref": "#/$defs/__schema11"
        },
        "unpriced_rows": {
          "$ref": "#/$defs/__schema11"
        },
        "assumptions": {
          "$ref": "#/$defs/__schema21"
        },
        "unpriced": {
          "$ref": "#/$defs/__schema23"
        },
        "unpriced_truncated": {
          "$ref": "#/$defs/__schema27"
        }
      },
      "required": [
        "mode",
        "basis",
        "status",
        "amount_microusd",
        "catalog_revision",
        "calculated_rows",
        "reported_rows",
        "unpriced_rows",
        "assumptions",
        "unpriced"
      ],
      "additionalProperties": false
    },
    "__schema16": {
      "type": "string",
      "enum": ["calculate", "auto", "reported"]
    },
    "__schema17": {
      "type": "string",
      "enum": ["calculated", "reported", "mixed", "none"]
    },
    "__schema18": {
      "type": "string",
      "enum": ["complete", "partial", "unavailable"]
    },
    "__schema19": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 32,
          "pattern": "^(?:0|[1-9]\\d*)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema20": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema1"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema21": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema22"
      }
    },
    "__schema22": {
      "type": "string",
      "enum": [
        "agent_default_channel",
