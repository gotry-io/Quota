        }
      },
      "required": ["provider", "label", "linked_at"],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "string",
      "enum": ["github", "apple", "email"]
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["active", "grace", "expired", "none"]
        },
        "expires_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema3"
            },
            {
              "type": "null"
            }
          ]
        },
        "will_renew": {
          "type": "boolean"
        },
        "product_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
