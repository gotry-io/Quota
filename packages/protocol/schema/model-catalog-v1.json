{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quota.gotry.io/schema/model-catalog-v1.json",
  "title": "Quota report-time model catalog v2",
  "$comment": "The catalog source is packages/protocol/catalog/model-catalog.json; quota-model additionally rejects duplicate IDs and overlapping aliases.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 2
    },
    "revision": {
      "$ref": "#/$defs/__schema0"
    },
    "models": {
      "minItems": 1,
      "maxItems": 512,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    }
  },
  "required": ["schema_version", "revision", "models"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "canonical_id": {
          "$ref": "#/$defs/__schema0"
        },
        "aliases": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        }
      },
      "required": ["canonical_id", "aliases"],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "reported_model": {
          "$ref": "#/$defs/__schema3"
        },
        "provider": {
          "$ref": "#/$defs/__schema4"
        },
        "agent": {
          "$ref": "#/$defs/__schema5"
        },
        "effective_from": {
          "$ref": "#/$defs/__schema6"
        },
        "effective_to": {
          "$ref": "#/$defs/__schema8"
        }
      },
      "required": ["reported_model", "provider"],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=[\\s\\S]{1,128}$)(?![\\s\\S]*\\p{Cc})[\\s\\S]+$"
    },
    "__schema4": {
      "type": "string",
      "enum": [
        "openai",
        "azure_openai",
        "anthropic",
        "aws_bedrock",
        "google_vertex",
        "openrouter",
        "xai",
        "moonshot",
        "deepseek",
        "unknown"
      ]
    },
    "__schema5": {
      "type": "string",
      "enum": ["codex", "claude_code", "grok", "opencode", "pi", "cursor"]
    },
    "__schema6": {
      "$ref": "#/$defs/__schema7"
    },
    "__schema7": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "__schema8": {
      "$ref": "#/$defs/__schema7"
    }
  }
}
