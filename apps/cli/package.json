{
  "name": "@gotry-io/quotacli",
  "version": "0.0.1",
  "description": "Inspect Codex, Claude Code, and Grok quota locally from one CLI.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "homepage": "https://quota.gotry.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gotry-io/Quota.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/gotry-io/Quota/issues"
  },
  "files": [
    "dist/npm/LICENSE",
    "dist/npm/quotacli.js",
    "README.md"
  ],
  "bin": {
    "quotacli": "dist/npm/quotacli.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "ai",
    "quota",
    "codex",
    "claude-code",
    "grok",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm run build:npm && pnpm run build:standalone",
    "build:npm": "bun run scripts/build-npm.ts",
    "build:standalone": "pnpm run build:standalone:macos-arm64",
    "build:standalone:macos-arm64": "bun build --compile --minify --target=bun-darwin-arm64 --outfile dist/standalone/quotacli src/main.ts",
    "check": "tsc -p tsconfig.json",
    "dev": "bun run src/main.ts",
    "prepack": "pnpm run build:npm",
    "test": "vitest run"
  },
  "devDependencies": {
    "@gotry-io/quota-model": "workspace:*",
    "@gotry-io/quota-protocol": "workspace:*",
    "@gotry-io/quota-provider": "workspace:*"
  }
}
