{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quota",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "quota-sveltekit-server": "../web/.svelte-kit/output/server/quota-sveltekit-server.js"
  },
  "routes": [
    {
      "pattern": "quota.gotry.io",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_app/*",
      "!/schema/*",
      "!/logo.svg",
      "!/logo-monochrome.svg",
      "!/og.png"
    ]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quota",
      "database_id": "e3bd8609-a9e0-4670-9182-62e8e2748d3f",
      "migrations_dir": "migrations"
    }
  ]
}
