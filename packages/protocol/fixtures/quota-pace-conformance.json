    {
      "name": "half the allowance at half the window is on track and lasts",
      "now": "2026-09-05T09:30:00Z",
      "window": {
        "id": "five_hour",
        "title": "5 Hours",
        "used_percent": 50,
        "resets_at": "2026-09-05T12:00:00Z",
        "duration_seconds": 18000,
        "primary_cadence": "five_hour"
      },
      "expected": {
        "kind": "lasts",
        "tempo": "on_track",
        "delta_percent": 0,
        "projected_at_reset": 100.0
      },
      "expected_headline": "Expected to last until reset",
      "expected_detail": "Using quota at an even pace"
    },
