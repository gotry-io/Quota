{
  "name": "@gotry-io/quota-web",
  "version": "0.0.3",
  "license": "MIT",
  "homepage": "https://quota.gotry.io",
  "private": true,
  "type": "module",
  "exports": {
    "./document-port": {
      "types": "./src/lib/server/document-port.ts"
    }
  },
  "scripts": {
    "build": "node scripts/publish-protocol-schemas.mjs && vite build && node scripts/stage-web-assets.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check-web-imports.mjs",
    "dev": "vite dev",
    "preview": "vite preview",
    "test": "node --test 'test/*.test.ts' && vitest run",
    "test:e2e": "playwright test",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@gotry-io/quota-model": "workspace:*",
    "@gotry-io/quota-protocol": "workspace:*",
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/svelte": "5.4.2",
    "jsdom": "30.0.1",
    "svelte": "5.56.9",
    "svelte-check": "4.7.6",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
