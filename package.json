{
  "name": "@gotry-io/quota",
  "version": "0.0.3",
  "license": "MIT",
  "homepage": "https://quota.gotry.io",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "./scripts/install-git-hooks.sh",
    "build": "pnpm --filter @gotry-io/quota-relay build && cargo build --locked --package quota-service --package quota-menubar-helper && swift build --package-path apps/menubar",
    "check": "pnpm check:provider-catalog && pnpm check:plan-display && pnpm check:schema && pnpm -r --if-present check && cargo check --locked --package quota-service --package quota-menubar-helper --all-targets",
    "check:provider-catalog": "node --experimental-strip-types scripts/generate-provider-catalog.mjs --check",
    "generate:provider-catalog": "node --experimental-strip-types scripts/generate-provider-catalog.mjs",
    "generate:plan-display": "node --experimental-strip-types scripts/generate-plan-display.mjs",
    "check:plan-display": "node --experimental-strip-types scripts/generate-plan-display.mjs --check",
    "version:bump:menubar": "node scripts/bump-version.mjs menubar",
    "version:bump:ios": "node scripts/bump-version.mjs ios",
    "format": "biome format --write . && cargo fmt --all",
    "format:check": "pnpm format:check:js && pnpm format:check:rust",
    "format:check:js": "biome format .",
    "format:check:rust": "cargo fmt --all -- --check",
    "test": "pnpm -r --if-present test && pnpm test:service && pnpm test:swift",
    "test:service": "cargo test --locked --package quota-service --package quota-menubar-helper",
    "test:swift": "./scripts/test-swift.sh",
    "test:menubar:helper": "./scripts/test-menubar-helper.sh",
    "build:menubar:app": "./scripts/package-menubar.sh",
    "build:menubar:visual": "./scripts/package-menubar-visual.sh",
    "generate:ios": "./scripts/generate-ios.sh",
    "check:ios": "./scripts/check-ios.sh",
    "test:ios": "./scripts/test-ios.sh",
    "build:ios": "./scripts/build-ios.sh",
    "deploy:cloudflare": "pnpm --filter @gotry-io/quota-relay deploy:cloudflare",
    "dev:web": "pnpm --filter @gotry-io/quota-web dev",
    "dev:relay": "pnpm --filter @gotry-io/quota-relay dev",
    "check:schema": "node --experimental-strip-types packages/protocol/scripts/generate-json-schemas.ts --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@cloudflare/workers-types": "5.20260801.1",
    "@types/node": "26.1.2",
    "ajv": "8.20.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  }
}
