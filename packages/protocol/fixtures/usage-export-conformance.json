          "start": "2026-08-25T16:00:00Z",
          "end": "2026-08-28T16:00:00Z",
          "grid": "first_whole_hour_of_local_date; fractional_midnight_to_previous_day; no_proration"
        },
        "cost_basis": "API-equivalent",
        "coverage": { "partial": true, "truncated_by_retention": false },
        "revision": {
          "usage_revision": 4,
          "device_generation": 1,
          "account_updated_at": "2026-08-28T10:00:00Z",
          "pricing_revision": "pricing_1",
          "model_catalog_revision": "models_1",
          "fold_version": 1
