        "usage_date",
        "usage_hour",
        "agent",
        "billing_channel",
        "channel_source",
        "model",
        "context_bucket",
        "service_tier",
        "speed",
        "inference_geo",
        "input_tokens",
        "cache_read_tokens",
        "cache_write_5m_tokens",
        "cache_write_1h_tokens",
