{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quota.gotry.io/schema/pricing-catalog-v2.json",
  "title": "Quota pricing catalog v2",
  "$comment": "quota-model additionally rejects duplicate IDs and entries whose channel/model/effective range/dimensions could resolve ambiguously.",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "number",
      "const": 2
    },
    "revision": {
      "$ref": "#/$defs/__schema0"
    },
    "published_at": {
      "$ref": "#/$defs/__schema1"
    },
    "entries": {
      "maxItems": 4096,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    }
  },
  "required": ["protocol_version", "revision", "published_at", "entries"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema1": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "entry_id": {
          "$ref": "#/$defs/__schema0"
        },
        "billing_channel": {
          "$ref": "#/$defs/__schema3"
        },
        "model": {
          "$ref": "#/$defs/__schema4"
        },
        "aliases": {
          "$ref": "#/$defs/__schema5"
        },
        "effective_from": {
          "$ref": "#/$defs/__schema6"
        },
        "effective_to": {
          "$ref": "#/$defs/__schema7"
        },
        "service_tier": {
          "$ref": "#/$defs/__schema8"
        },
        "speed": {
          "$ref": "#/$defs/__schema8"
        },
        "inference_geo": {
          "$ref": "#/$defs/__schema8"
        },
        "context_bucket": {
          "$ref": "#/$defs/__schema9"
        },
        "currency": {
          "$ref": "#/$defs/__schema10"
        },
        "rates": {
          "$ref": "#/$defs/__schema11"
        },
        "source_url": {
          "$ref": "#/$defs/__schema21"
        },
        "verified_at": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "entry_id",
        "billing_channel",
        "model",
        "aliases",
        "effective_from",
        "effective_to",
        "service_tier",
        "speed",
        "inference_geo",
        "context_bucket",
        "currency",
        "rates",
        "source_url",
        "verified_at"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "string",
      "enum": [
        "openai_direct",
        "azure_openai",
        "anthropic_direct",
        "aws_bedrock",
        "google_vertex",
        "openrouter",
        "xai_direct",
        "moonshot_direct",
        "deepseek_direct"
      ]
    },
    "__schema4": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=[\\s\\S]{1,128}$)(?![\\s\\S]*\\p{Cc})[\\s\\S]+$"
    },
    "__schema5": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "__schema6": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "__schema7": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema6"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema8": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
        },
        {
          "type": "string",
          "const": "*"
        }
      ]
    },
    "__schema9": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["le_128k", "gt_128k_le_200k", "gt_200k_le_256k", "gt_256k_le_272k", "gt_272k"]
        },
        {
          "type": "string",
          "const": "*"
        }
      ]
    },
    "__schema10": {
      "type": "string",
      "const": "USD"
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "uncached_input_per_million": {
          "$ref": "#/$defs/__schema12"
        },
        "cache_read_per_million": {
          "$ref": "#/$defs/__schema14"
        },
        "cache_write_5m_per_million": {
          "$ref": "#/$defs/__schema15"
        },
        "cache_write_1h_per_million": {
          "$ref": "#/$defs/__schema16"
        },
        "cache_write_inferred_per_million": {
          "$ref": "#/$defs/__schema17"
        },
        "output_per_million": {
          "$ref": "#/$defs/__schema18"
        },
        "web_search_per_request": {
          "$ref": "#/$defs/__schema19"
        },
        "web_fetch_per_request": {
          "$ref": "#/$defs/__schema20"
        }
      },
      "required": [
        "uncached_input_per_million",
        "cache_read_per_million",
        "cache_write_5m_per_million",
        "cache_write_1h_per_million",
        "cache_write_inferred_per_million",
        "output_per_million",
        "web_search_per_request",
        "web_fetch_per_request"
      ],
      "additionalProperties": false
    },
    "__schema12": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema13"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema13": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d{1,12})?$"
    },
    "__schema14": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema13"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema15": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema13"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema16": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema13"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema17": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema13"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema18": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema13"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema19": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema13"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema20": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema13"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema21": {
      "type": "string",
      "maxLength": 2048,
      "format": "uri"
    }
  }
}
