{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quota.gotry.io/schema/quota-collection-report.json",
  "title": "Quota local collection report",
  "$comment": "Success snapshots must use the same provider as their collection result.",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "number",
      "const": 4
    },
    "captured_at": {
      "$ref": "#/$defs/__schema0"
    },
    "results": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    }
  },
  "required": ["protocol_version", "captured_at", "results"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema1": {
      "oneOf": [
        {
          "$ref": "#/$defs/__schema2"
        },
        {
          "$ref": "#/$defs/__schema12"
        }
      ]
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/__schema3"
        },
        "source": {
          "$ref": "#/$defs/__schema4"
        },
        "message": {
          "$ref": "#/$defs/__schema6"
        },
        "sources": {
          "$ref": "#/$defs/__schema7"
        },
        "access_denied": {
          "$ref": "#/$defs/__schema9"
        },
        "outcome": {
          "type": "string",
          "const": "success"
        },
        "snapshots": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema10"
          }
        }
      },
      "required": ["provider", "sources", "outcome", "snapshots"],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "string",
      "enum": ["codex", "claude", "grok", "openrouter", "deepseek", "kimi", "litellm", "cursor"]
    },
    "__schema4": {
      "$ref": "#/$defs/__schema5"
    },
    "__schema5": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
    },
    "__schema6": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "__schema7": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema8"
      }
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "source_id": {
          "$ref": "#/$defs/__schema5"
        },
        "outcome": {
          "type": "string",
          "enum": ["success", "auth_required", "unavailable", "unsupported", "error"]
        },
        "category": {
          "type": "string",
          "enum": [
            "success",
            "auth_required",
            "access_denied",
            "unavailable",
            "unsupported",
            "error"
          ]
        }
      },
      "required": ["source_id", "outcome", "category"],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "boolean",
      "const": true
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/__schema3"
        },
        "account": {
          "type": "object",
          "properties": {
            "fingerprint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "fingerprint_scope": {
              "type": "string",
              "enum": ["global", "source"]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "plan": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": ["fingerprint", "fingerprint_scope"],
          "additionalProperties": false
        },
        "windows": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema11"
          }
        },
        "status": {
          "type": "string",
          "enum": ["available", "stale", "auth_required", "unavailable", "unsupported", "error"]
        },
        "observed_at": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": ["provider", "account", "windows", "status", "observed_at"],
      "additionalProperties": false
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "used_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "resets_at": {
          "$ref": "#/$defs/__schema0"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "remaining_value": {
          "type": "number"
        },
        "limit_value": {
          "type": "number",
          "minimum": 0
        },
        "value_unit": {
          "type": "string",
          "enum": ["usd", "credits", "count"]
        }
      },
      "required": ["id", "title", "used_percent"],
      "additionalProperties": false
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/__schema3"
        },
        "source": {
          "$ref": "#/$defs/__schema4"
        },
        "message": {
          "$ref": "#/$defs/__schema6"
        },
        "sources": {
          "$ref": "#/$defs/__schema7"
        },
        "access_denied": {
          "$ref": "#/$defs/__schema9"
        },
        "outcome": {
          "type": "string",
          "enum": ["auth_required", "unavailable", "unsupported", "error"]
        },
        "snapshots": {
          "maxItems": 0,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema10"
          }
        }
      },
      "required": ["provider", "sources", "outcome", "snapshots"],
      "additionalProperties": false
    }
  }
}
