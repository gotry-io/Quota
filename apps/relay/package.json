{
  "name": "@gotry-io/quota-relay",
  "version": "0.0.9",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:node",
    "build:web": "pnpm --filter @gotry-io/quota-web build",
    "check": "tsc -p tsconfig.json",
    "dev": "pnpm run build:web && node ./scripts/dev-node.mjs",
    "test": "vitest run --config vitest.node.config.ts",
    "test:node:integration": "vitest run --config vitest.node.integration.config.ts",
    "test:restore-drill": "vitest run --config vitest.node.integration.config.ts test/restore-drill.integration.test.ts",
    "build:node": "esbuild src/node.ts --bundle --platform=node --format=esm --target=node24 --external:better-sqlite3 --alias:quota-sveltekit-server=../web/.svelte-kit/output/server/quota-sveltekit-server.js --outfile=dist/node/server.mjs",
    "start:node": "node dist/node/server.mjs"
  },
  "dependencies": {
    "@gotry-io/quota-model": "workspace:*",
    "@gotry-io/quota-protocol": "workspace:*",
    "@gotry-io/relay-core": "workspace:*",
    "@hono/node-server": "2.1.1",
    "better-sqlite3": "13.0.3",
    "hono": "4.12.33"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "esbuild": "0.28.2"
  }
}
