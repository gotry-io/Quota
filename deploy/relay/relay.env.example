GITHUB_CLIENT_SECRET=
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_SERVICES_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
# Each of these three must be at least 32 characters. Generate replacements with
# `openssl rand -hex 24`. Shorter values refuse to start.
IDENTITY_SUBJECT_KEY=5e4e46d7a3040f6a506cf930ff6b3b0429d784482080b67d
QUOTA_INSTALLATION_KEY=38e73f819eea71321ad6a2d73d77cdeb0af7414659f59b47
QUOTA_SESSION_HASH_KEY=d25290d0a757c0d844e478486a706bc75f42c3b465e8a79b
RESEND_API_KEY=
RELAY_SQLITE_PATH=
RELAY_STATIC_DIR=
PORT=
# Both stack files fix RELAY_CLIENT_ADDRESS_HEADER=cf-connecting-ip: the Tunnel
# connector is Relay's only peer. Set these two only for a different topology —
# e.g. a reverse proxy that overwrites X-Forwarded-For (leave the header unset),
# or proxies outside loopback/RFC1918/unique-local (list their CIDRs). Invalid
# values refuse to start. Do not list the public internet.
RELAY_TRUSTED_PROXIES=
RELAY_CLIENT_ADDRESS_HEADER=
# Token of the remotely managed Cloudflare Tunnel `quota-relay`
# (Zero Trust > Networks > Tunnels > quota-relay).
TUNNEL_TOKEN=
TZ=
