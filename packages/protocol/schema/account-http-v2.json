  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "account_id": {
          "$ref": "#/$defs/__schema1"
        },
        "display_label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": ["account_id", "display_label", "created_at"],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema2": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "#/$defs/__schema1"
        },
        "display_name": {
          "$ref": "#/$defs/__schema4"
        },
        "platform": {
          "$ref": "#/$defs/__schema5"
        },
        "device_generation": {
          "$ref": "#/$defs/__schema6"
        },
        "status": {
          "$ref": "#/$defs/__schema8"
        },
        "created_at": {
          "$ref": "#/$defs/__schema2"
        },
        "last_login_at": {
          "$ref": "#/$defs/__schema2"
        },
        "last_seen_at": {
          "$ref": "#/$defs/__schema9"
        },
        "signed_out_at": {
          "$ref": "#/$defs/__schema10"
        }
      },
      "required": [
        "device_id",
        "display_name",
        "platform",
        "device_generation",
        "status",
        "created_at",
        "last_login_at",
        "last_seen_at",
        "signed_out_at"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "__schema5": {
      "type": "string",
      "enum": ["macos", "linux", "windows"]
    },
    "__schema6": {
      "minimum": 1,
      "$ref": "#/$defs/__schema7"
    },
    "__schema7": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema8": {
      "type": "string",
      "enum": ["active", "offline", "signed_out"]
    },
    "__schema9": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema2"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema10": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema2"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "#/$defs/__schema1"
        },
        "sequence": {
          "$ref": "#/$defs/__schema7"
        },
        "captured_at": {
          "$ref": "#/$defs/__schema2"
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": ["codex", "claude", "grok", "openrouter", "deepseek", "kimi", "litellm"]
            },
            "account": {
              "type": "object",
              "properties": {
                "fingerprint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                "fingerprint_scope": {
                  "type": "string",
                  "enum": ["global", "source"]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "plan": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "required": ["fingerprint", "fingerprint_scope"],
              "additionalProperties": false
            },
            "windows": {
              "maxItems": 16,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema12"
              }
            },
            "source": {
              "$ref": "#/$defs/__schema13"
            },
            "status": {
              "type": "string",
              "enum": ["available", "stale", "auth_required", "unavailable", "unsupported", "error"]
            },
            "observed_at": {
              "$ref": "#/$defs/__schema2"
            },
            "valid_until": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "required": ["provider", "account", "windows", "source", "status", "observed_at"],
          "additionalProperties": false
        },
        "updated_at": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": ["device_id", "sequence", "captured_at", "snapshot", "updated_at"],
      "additionalProperties": false
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "used_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "resets_at": {
          "$ref": "#/$defs/__schema2"
        },
        "duration_seconds": {
          "$ref": "#/$defs/__schema7"
        },
        "remaining_value": {
          "type": "number"
        },
        "limit_value": {
          "type": "number",
          "minimum": 0
        },
        "value_unit": {
          "type": "string",
          "enum": ["usd", "credits", "count"]
        }
      },
      "required": ["id", "title", "used_percent"],
      "additionalProperties": false
    },
    "__schema13": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "range": {
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/$defs/__schema15"
            },
            "to": {
              "$ref": "#/$defs/__schema15"
            }
          },
          "required": ["from", "to"],
          "additionalProperties": false
        },
        "totals": {
          "$ref": "#/$defs/__schema16"
        },
        "cost": {
          "$ref": "#/$defs/__schema18"
        },
        "coverage": {
          "maxItems": 2048,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema31"
          }
        },
        "breakdowns": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema35"
          }
        },
        "coverage_truncated": {
          "type": "boolean",
          "const": true
        },
        "breakdowns_truncated": {
          "type": "boolean",
          "const": true
        }
      },
      "required": ["range", "totals", "cost", "coverage", "breakdowns"],
      "additionalProperties": false
    },
    "__schema15": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "__schema16": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "$ref": "#/$defs/__schema7"
        },
        "cache_read_tokens": {
          "$ref": "#/$defs/__schema7"
        },
        "cache_write_5m_tokens": {
          "$ref": "#/$defs/__schema7"
        },
        "cache_write_1h_tokens": {
          "$ref": "#/$defs/__schema7"
        },
        "cache_write_inferred_tokens": {
          "$ref": "#/$defs/__schema7"
        },
        "output_tokens": {
          "$ref": "#/$defs/__schema7"
        },
        "reasoning_tokens": {
          "$ref": "#/$defs/__schema7"
        },
        "requests": {
          "$ref": "#/$defs/__schema7"
        },
        "web_search_requests": {
          "$ref": "#/$defs/__schema7"
        },
        "web_fetch_requests": {
          "$ref": "#/$defs/__schema7"
        },
        "source_cost_microusd": {
          "$ref": "#/$defs/__schema17"
        },
        "source_cost_covered_requests": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": [
        "input_tokens",
        "cache_read_tokens",
        "cache_write_5m_tokens",
