{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quota.gotry.io/schema/provider-catalog.json",
  "title": "Quota provider catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "providers"],
  "properties": {
    "schema_version": { "const": 1 },
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/provider" }
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "order",
        "default_visible",
        "setup_action",
        "brand_icon_asset",
        "account_sync",
        "environment_keys",
        "credential_config",
        "browser_session",
        "default_base_url",
        "base_url_environment_key"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
        },
        "order": { "type": "integer", "minimum": 0, "maximum": 63 },
        "default_visible": { "type": "boolean" },
        "setup_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
        },
        "brand_icon_asset": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "account_sync": {
          "type": "boolean",
          "description": "Managed Account/Relay upload. Product default is true; set false only for an explicit local-only provider."
        },
        "environment_keys": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "uniqueItems": true
        },
        "credential_config": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/api_key_config" }]
        },
        "browser_session": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/browser_session" }]
        },
        "default_base_url": { "type": ["string", "null"], "maxLength": 2048 },
        "base_url_environment_key": {
          "type": ["string", "null"],
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        }
      }
    },
    "api_key_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "supports_base_url",
        "requires_base_url",
        "allow_private_http",
        "mask_label"
      ],
      "properties": {
        "kind": { "const": "api_key" },
        "supports_base_url": { "type": "boolean" },
        "requires_base_url": { "type": "boolean" },
        "allow_private_http": { "type": "boolean" },
        "mask_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
        }
      }
    },
    "browser_session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["login_url", "cookie_hosts", "cookie_names", "browser_priority", "exclusive"],
      "properties": {
        "login_url": { "type": "string", "pattern": "^https://", "maxLength": 2048 },
        "cookie_hosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
          }
        },
        "cookie_names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
          }
        },
        "browser_priority": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          }
        },
        "exclusive": {
          "type": "boolean",
          "description": "When true, Settings omits the official CLI sign-in command because the provider has no CLI or API-key login."
        }
      }
    }
  }
}
