{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quota",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "quota.gotry.io",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/healthz", "/readyz", "/oauth/*", "/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quota",
      "database_id": "e3bd8609-a9e0-4670-9182-62e8e2748d3f",
      "migrations_dir": "migrations"
    }
  ]
}
