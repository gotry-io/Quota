      "enum": ["calculated", "reported", "mixed", "none"]
    },
    "__schema23": {
      "type": "string",
      "enum": ["complete", "partial", "unavailable"]
    },
    "__schema24": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 32,
          "pattern": "^(?:0|[1-9]\\d*)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema25": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema1"
        },
        {
          "type": "null"
        }
      ]
