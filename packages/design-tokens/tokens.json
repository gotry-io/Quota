      "accent": {
        "light": "#087456",
        "dark": "#82ddb8",
        "css": ["--brand-accent", "--brand-emerald"],
        "css_dark": ["--brand-mint"]
      }
    },
    "quota": {
      "healthy": {
        "light": "#087456",
        "dark": "#82ddb8",
