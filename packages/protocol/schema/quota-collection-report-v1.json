{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quota.gotry.io/schema/quota-collection-report-v1.json",
  "title": "Quota collection report",
  "type": "object",
  "required": [
    "schema_version",
    "captured_at",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "required": [
        "provider",
        "outcome",
        "snapshots"
      ],
      "properties": {
        "provider": { "enum": ["codex", "claude", "grok", "openrouter", "deepseek", "kimi", "litellm"] },
        "outcome": {
          "enum": [
            "success",
            "auth_required",
            "unavailable",
            "unsupported",
            "error"
          ]
        },
        "snapshots": {
          "type": "array",
          "items": {
            "$ref": "quota-snapshot-v1.json#/$defs/snapshot"
          }
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "properties": {
            "outcome": {
              "const": "success"
            },
            "snapshots": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "enum": [
                "auth_required",
                "unavailable",
                "unsupported",
                "error"
              ]
            },
            "snapshots": {
              "maxItems": 0
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
