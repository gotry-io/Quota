          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "invalid_request",
                "unauthorized",
                "forbidden",
                "not_found",
                "authorization_pending",
                "slow_down",
                "access_denied",
                "expired_token",
                "invalid_grant",
                "rate_limited",
                "sequence_conflict",
                "stale_generation",
                "device_deleted",
                "client_upgrade_required",
                "conflict",
                "internal_error"
              ]
