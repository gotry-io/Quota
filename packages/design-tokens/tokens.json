{
  "schema_version": 1,
  "color": {
    "brand": {
      "accent": {
        "light": "#087456",
        "dark": "#82ddb8",
        "css": ["--brand-accent", "--brand-emerald"],
        "css_dark": ["--brand-mint"]
      }
    },
    "quota": {
      "healthy": {
        "light": "#087456",
        "dark": "#82ddb8",
        "css": ["--quota-healthy", "--meter-good"]
      },
      "warning": {
        "light": "#b45309",
        "dark": "#f0b429",
        "css": ["--quota-warning", "--meter-warn"]
      },
      "critical": {
        "light": "#9f1d1d",
        "dark": "#f0a8a8",
        "css": ["--quota-critical", "--meter-critical", "--danger"]
      }
    },
    "meter": {
      "track": {
        "light": "#e5e5e5",
        "dark": "#333333",
        "css": ["--meter-track"]
      }
    },
    "text": {
      "primary": {
        "light": "#000000",
        "dark": "#f4f4f4",
        "css": ["--text-primary", "--ink"]
      },
      "secondary": {
        "light": "#525252",
        "dark": "#c4c4c4",
        "css": ["--text-secondary", "--charcoal"]
      },
      "meta": {
        "light": "#6b6b6b",
        "dark": "#8f8f8f",
        "css": ["--text-meta", "--mute"]
      }
    },
    "surface": {
      "canvas": {
        "light": "#ffffff",
        "dark": "#111111",
        "css": ["--surface-canvas", "--canvas"]
      },
      "content": {
        "light": "#fafafa",
        "dark": "#1b1b1b",
        "css": ["--surface-content", "--surface-soft"]
      }
    },
    "border": {
      "subtle": {
        "light": "#e5e5e5",
        "dark": "#2a2a2a",
        "css": ["--border-subtle", "--hairline"]
      }
    },
    "activity": {
      "0": {
        "fill": {
          "light": "#efefef",
          "dark": "#2a2a2a",
          "css": ["--activity-0"]
        },
        "border": {
          "light": "#e5e5e5",
          "dark": "#2a2a2a",
          "css": ["--activity-0-border"]
        }
      },
      "1": {
        "fill": {
          "light": "#c6eddc",
          "dark": "#134d3a",
          "css": ["--activity-1"]
        },
        "border": {
          "light": "#9ad9bf",
          "dark": "#1a7a58",
          "css": ["--activity-1-border"]
        }
      },
      "2": {
        "fill": {
          "light": "#82ddb8",
          "dark": "#1a7a58",
          "css": ["--activity-2"]
        },
        "border": {
          "light": "#5ecaa0",
          "dark": "#2fa37a",
          "css": ["--activity-2-border"]
        }
      },
      "3": {
        "fill": {
          "light": "#2fa37a",
          "dark": "#2fa37a",
          "css": ["--activity-3"]
        },
        "border": {
          "light": "#087456",
          "dark": "#82ddb8",
          "css": ["--activity-3-border"]
        }
      },
      "4": {
        "fill": {
          "light": "#087456",
          "dark": "#82ddb8",
          "css": ["--activity-4"]
        },
        "border": {
          "light": "#065a43",
          "dark": "#b6ead4",
          "css": ["--activity-4-border"]
        }
      }
    },
    "chart": {
      "input": {
        "light": "#82ddb8",
        "dark": "#1a7a58",
        "css": ["--chart-input"]
      },
      "cache": {
        "light": "#c6eddc",
        "dark": "#134d3a",
        "css": ["--chart-cache"]
      },
      "output": {
        "light": "#087456",
        "dark": "#82ddb8",
        "css": ["--chart-output"]
      }
    }
  },
  "threshold": {
    "quota_healthy_percent": 40,
    "quota_warning_percent": 15
  },
  "spacing": [4, 8, 12, 16, 24, 32, 48],
  "radius": {
    "control": 8,
    "group": 12,
    "card": 16
  },
  "overrides": {
    "apple": {
      "radius": {
        "card": 20
      },
      "color": {
        "text": {
          "primary": { "system": "label" },
          "secondary": {
            "light": "#6b6b70",
            "dark": { "system": "secondaryLabel" }
          },
          "meta": { "system": "tertiaryLabel" }
        },
        "meter": {
          "track": { "system": "tertiarySystemFill" }
        },
        "activity": {
          "0": { "border": { "system": "separator" } },
          "1": { "border": { "light": "#2fa37a", "dark": "#51b391" } },
          "2": { "border": { "light": "#2fa37a", "dark": "#51b391" } },
          "3": { "border": { "light": "#2fa37a", "dark": "#51b391" } },
          "4": { "border": { "light": "#2fa37a", "dark": "#51b391" } }
        },
        "chart": {
          "input": {
            "light": "#087456",
            "dark": "#82ddb8"
          },
          "cache": {
            "light": "#399078",
            "dark": "#2d9374"
          },
          "output": { "system": "label", "opacity": 0.85 }
        }
      }
    }
  }
}
