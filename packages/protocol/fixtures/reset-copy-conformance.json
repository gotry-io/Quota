      "now": "2026-09-07T14:00:00-07:00",
      "resets_at": "2026-09-07T17:00:00-07:00",
      "relative": "Resets in 3h",
      "absolute": "Resets Mon 17:00"
    },
    {
      "name": "three hours and twelve minutes names both",
