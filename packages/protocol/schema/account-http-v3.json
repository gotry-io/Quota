        "display_name": {
          "$ref": "#/$defs/__schema9"
        },
        "platform": {
          "$ref": "#/$defs/__schema10"
        },
        "device_generation": {
          "$ref": "#/$defs/__schema11"
        },
        "status": {
          "$ref": "#/$defs/__schema12"
        },
        "created_at": {
          "$ref": "#/$defs/__schema3"
        },
        "last_login_at": {
          "$ref": "#/$defs/__schema3"
        },
        "last_seen_at": {
          "$ref": "#/$defs/__schema13"
        },
        "signed_out_at": {
          "$ref": "#/$defs/__schema14"
        }
      },
      "required": [
        "device_id",
        "display_name",
        "platform",
        "device_generation",
        "status",
        "created_at",
        "last_login_at",
        "last_seen_at",
        "signed_out_at"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "__schema10": {
      "type": "string",
      "enum": ["macos", "linux", "windows"]
    },
    "__schema11": {
      "minimum": 1,
      "$ref": "#/$defs/__schema2"
    },
    "__schema12": {
      "type": "string",
      "enum": ["active", "offline", "signed_out"]
    },
    "__schema13": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema3"
        },
        {
          "type": "null"
        }
      ]
